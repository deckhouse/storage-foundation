+// TestCreatePVFromCSIResponse_CapacityFallback exercises the capacity fallback chain
+// directly: the driver-reported capacity wins when non-zero; otherwise requestedBytes
+// is used; otherwise defaultVolumeCapacityBytes is the last resort.
+func TestCreatePVFromCSIResponse_CapacityFallback(t *testing.T) {
+	sc := ourStorageClass()
+	volumeCaps := []*csi.VolumeCapability{
+		{
+			AccessType: getAccessTypeMount("ext4", nil),
+			AccessMode: &csi.VolumeCapability_AccessMode{Mode: csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER},
+		},
+	}
+
+	tests := []struct {
+		name           string
+		driverCapacity int64
+		requestedBytes int64
+		wantCapacity   int64
+	}{
+		{
+			name:           "success: driver-reported capacity wins when non-zero",
+			driverCapacity: 3 * 1024 * 1024 * 1024,
+			requestedBytes: 10 * 1024 * 1024 * 1024,
+			wantCapacity:   3 * 1024 * 1024 * 1024,
+		},
+		{
+			name:           "success: requestedBytes is used when driver reports zero capacity",
+			driverCapacity: 0,
+			requestedBytes: 5 * 1024 * 1024 * 1024,
+			wantCapacity:   5 * 1024 * 1024 * 1024,
+		},
+		{
+			name:           "success: defaultVolumeCapacityBytes is used when both driver and requestedBytes are zero",
+			driverCapacity: 0,
+			requestedBytes: 0,
+			wantCapacity:   defaultVolumeCapacityBytes,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			volume := &csi.Volume{VolumeId: "test-volume-id", CapacityBytes: tt.driverCapacity}
+
+			pv, err := createPVFromCSIResponse(volume, sc, "test-pv", vrrTestDriverName, vrrTestIdentity, volumeCaps, "ext4",
+				nil, tt.requestedBytes, vrrSecretRefs{})
+			if err != nil {
+				t.Fatalf("createPVFromCSIResponse failed: %v", err)
+			}
+			if got := pv.Spec.Capacity[v1.ResourceStorage]; got.Value() != tt.wantCapacity {
+				t.Errorf("PV Capacity = %s (%d bytes), want %d bytes", got.String(), got.Value(), tt.wantCapacity)
+			}
+		})
+	}
+}

+		{name: "error: reused PV without nodeStageSecretRef names that field", expandRef: secretRef, wantFields: ": nodeStageSecretRef;"},
+		{name: "success: reused PV with every secret reference is not reported", stageRef: secretRef, expandRef: secretRef},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			defer ctrl.Finish()
+
+			sc := ourStorageClass()
+			sc.Parameters = map[string]string{
+				"csi.storage.k8s.io/node-stage-secret-name":             secretRef.Name,
+				"csi.storage.k8s.io/node-stage-secret-namespace":        secretRef.Namespace,
+				"csi.storage.k8s.io/controller-expand-secret-name":      secretRef.Name,
+				"csi.storage.k8s.io/controller-expand-secret-namespace": secretRef.Namespace,
+			}
+			mockSCLister := NewMockStorageClassLister(ctrl)
+			mockSCLister.storageClasses[vrrTestStorageClass] = sc

+// TestReconcile_RecordsStorageClassSecretRefs verifies that the PV the executor creates
+// carries the secret references of the StorageClass in spec.csi, as a dynamically
+// provisioned PV does. spec.csi is immutable, and without nodeStageSecretRef ceph-csi
+// rejects NodeStageVolume with "stage secrets cannot be nil or empty", so a restored
+// volume can never be mounted.
+func TestReconcile_RecordsStorageClassSecretRefs(t *testing.T) {
+	const (
+		secretName      = "csi-secret"
+		secretNamespace = "csi-ns"

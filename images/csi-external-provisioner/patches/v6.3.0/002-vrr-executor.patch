+// TestReconcile_FromVSC_VolumeCapacityPrecedence verifies that restoreFromVSC picks the
+// effective volume capacity in this priority order: requested pvcTemplate size >
+// VolumeSnapshotContent RestoreSize > defaultVolumeCapacityBytes - and never picks a size
+// smaller than RestoreSize, since the restored data must fit.
+//
+// Regression coverage: on drivers that report CapacityBytes: 0 in the CSI CreateVolume
+// response (csi-driver-nfs does this by design - see controllerserver.go: "by setting it
+// to zero, Provisioner will use PVC requested size as PV size"), the executor used to
+// always fall back to a hardcoded 1Gi and ignored both RestoreSize and the user's
+// requested size. This test also asserts what is actually sent to the CSI driver
+// (CapacityRange.RequiredBytes), not just the resulting PV/PVC.
+func TestReconcile_FromVSC_VolumeCapacityPrecedence(t *testing.T) {
+	tests := []struct {
+		name             string
+		requestedStorage *resource.Quantity
+		restoreSize      *int64
+		wantCapacity     int64
+	}{
+		{
+			name:             "success: requested size wins over a smaller RestoreSize",
+			requestedStorage: quantityPtr(resource.MustParse("10Gi")),
+			restoreSize:      int64Ptr(1024 * 1024 * 1024), // 1Gi
+			wantCapacity:     10 * 1024 * 1024 * 1024,
+		},
+		{
+			// 3Gi rather than 1Gi: an implementation that dropped RestoreSize and fell through
+			// to defaultVolumeCapacityBytes would still satisfy a 1Gi expectation.
+			name:         "success: RestoreSize is used when no size is requested",
+			restoreSize:  int64Ptr(3 * 1024 * 1024 * 1024),
+			wantCapacity: 3 * 1024 * 1024 * 1024,
+		},
+		{
+			name:             "success: RestoreSize wins when larger than the requested size",
+			requestedStorage: quantityPtr(resource.MustParse("500Mi")),
+			restoreSize:      int64Ptr(1024 * 1024 * 1024), // 1Gi
+			wantCapacity:     1024 * 1024 * 1024,
+		},
+		{
+			name:         "success: default capacity is used when neither requested size nor RestoreSize is set",
+			wantCapacity: defaultVolumeCapacityBytes,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			defer ctrl.Finish()
+
+			mockSCLister := NewMockStorageClassLister(ctrl)
+			mockSCLister.storageClasses[vrrTestStorageClass] = ourStorageClass()
+
+			vrr := createTestVRR("test-vrr", "test-ns", "VolumeSnapshotContent", "test-vsc")
+			if tt.requestedStorage != nil {
+				vrr.Spec.PvcTemplate.Resources.Requests = storagev1alpha1.ResourceList{
+					storagev1alpha1.ResourceStorage: *tt.requestedStorage,
+				}
+			}
+
+			vsc := readyVSC("test-vsc", vrrTestSnapshotHandle)
+			vsc.Status.RestoreSize = tt.restoreSize
+
+			kubeClient := fakeclientset.NewSimpleClientset()
+			snapshotClient := snapfake.NewSimpleClientset(vsc)
+
+			var gotRequiredBytes int64
+			mockCSIClient := &mockControllerClient{
+				createVolumeFunc: func(_ context.Context, req *csi.CreateVolumeRequest) (*csi.CreateVolumeResponse, error) {
+					gotRequiredBytes = req.CapacityRange.GetRequiredBytes()
+					// Mimic csi-driver-nfs: CapacityBytes 0 means "use the requested size".
+					return &csi.CreateVolumeResponse{Volume: &csi.Volume{VolumeId: "new-volume-id", CapacityBytes: 0}}, nil
+				},
+			}
+
+			e := newTestExecutor(mockCSIClient, mockSCLister, kubeClient, snapshotClient, nil)
+			if err := reconcileVRR(t, e, vrr); err != nil {
+				t.Fatalf("reconcile failed: %v", err)
+			}
+
+			if gotRequiredBytes != tt.wantCapacity {
+				t.Errorf("CSI CreateVolumeRequest.CapacityRange.RequiredBytes = %d, want %d", gotRequiredBytes, tt.wantCapacity)
+			}
+
+			pvName := expectedPVName(t, vrr)
+			pv, err := kubeClient.CoreV1().PersistentVolumes().Get(context.Background(), pvName, metav1.GetOptions{})
+			if err != nil {
+				t.Fatalf("expected PV %s to exist: %v", pvName, err)
+			}
+			if got := pv.Spec.Capacity[v1.ResourceStorage]; got.Value() != tt.wantCapacity {
+				t.Errorf("PV Capacity = %s (%d bytes), want %d bytes", got.String(), got.Value(), tt.wantCapacity)
+			}
+
+			pvc, err := kubeClient.CoreV1().PersistentVolumeClaims(vrrTestTargetNamespace).Get(context.Background(), vrrTestTargetPVCName, metav1.GetOptions{})
+			if err != nil {
+				t.Fatalf("expected target PVC to exist: %v", err)
+			}
+			if got := pvc.Spec.Resources.Requests[v1.ResourceStorage]; got.Value() != tt.wantCapacity {
+				t.Errorf("PVC Resources.Requests[storage] = %s (%d bytes), want %d bytes", got.String(), got.Value(), tt.wantCapacity)
+			}

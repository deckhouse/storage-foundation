+			case "PersistentVolume":
+				vrr = createTestVRR("test-vrr", vrrTestTargetNamespace, "PersistentVolume", "source-pv")
+				if _, err := kubeClient.CoreV1().PersistentVolumes().Create(context.Background(), csiPV("source-pv", vrrTestVolumeHandle), metav1.CreateOptions{}); err != nil {
+					t.Fatalf("failed to seed source PV: %v", err)
+				}
+			}
+
+			createVolumeCalled := false
+			mockCSIClient := &mockControllerClient{
+				createVolumeFunc: func(_ context.Context, _ *csi.CreateVolumeRequest) (*csi.CreateVolumeResponse, error) {
+					createVolumeCalled = true
+					return &csi.CreateVolumeResponse{Volume: &csi.Volume{VolumeId: "new-volume-id", CapacityBytes: 1024 * 1024 * 1024}}, nil
+				},
+			}
+
+			eventRecorder := record.NewFakeRecorder(10)
+			e := newTestExecutor(mockCSIClient, mockSCLister, kubeClient, snapshotClient, eventRecorder)
+			if err := reconcileVRR(t, e, vrr); err != nil {
+				t.Fatalf("reconcile failed: %v", err)

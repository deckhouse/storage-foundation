+			}
+			for _, ann := range []string{annModifyControllerSecretRefName, annModifyControllerSecretRefNamespace} {
+				got, ok := pv.Annotations[ann]
+				want, wantOK := tt.wantAnnotations[ann]
+				if ok != wantOK || got != want {
+					t.Errorf("PV annotation %q = %q (present %v), want %q (present %v)", ann, got, ok, want, wantOK)
+				}
+			}
+		})
+	}

+				PersistentVolumeClaimTemplateMetadata: storagev1alpha1.PersistentVolumeClaimTemplateMetadata{
+					Name: vrrTestTargetPVCName,
+				},
+				PersistentVolumeClaimSpec: storagev1alpha1.PersistentVolumeClaimSpec{
+					StorageClassName: &scName,
+					VolumeMode:       &fsMode,
+				},
+			},
+		},
+		Status: storagev1alpha1.VolumeRestoreRequestStatus{
+			Conditions: []metav1.Condition{{
+				Type:   storagev1alpha1.ConditionTypeSourceVerified,
+				Status: metav1.ConditionTrue,
+				Reason: storagev1alpha1.ConditionReasonSourceInNamespace,
+			}},
+		},
+	}
+}

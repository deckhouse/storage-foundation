+				}
+				if _, err := kubeClient.CoreV1().PersistentVolumes().Get(context.Background(), pvName, metav1.GetOptions{}); !apierrors.IsNotFound(err) {
+					t.Errorf("expected no PV %s, got err=%v", pvName, err)

+// TestReconcile_StripsReservedStorageClassParameters is a regression test for the
+// VRR-executor fix that strips reserved csi.storage.k8s.io/* StorageClass parameters
+// before calling CSI CreateVolume: previously they were forwarded verbatim and a
+// driver that validates parameters strictly (e.g. csi-driver-nfs) rejected the whole
+// request, so the restore never materialized.
+func TestReconcile_StripsReservedStorageClassParameters(t *testing.T) {
+	const (
+		provisionerSecretName      = "vrr-provisioner-secret"
+		provisionerSecretNamespace = "vrr-secret-ns"
+	)
+
+	tests := []struct {
+		name            string
+		scParameters    map[string]string
+		wantCreateCall  bool
+		wantEventReason string
+	}{
+		{
+			name: "success: reserved csi.storage.k8s.io/* keys are stripped, plain keys and secret resolution survive",
+			scParameters: map[string]string{
+				"server": "1.2.3.4",
+				"share":  "/export",
+				"csi.storage.k8s.io/provisioner-secret-name":      provisionerSecretName,
+				"csi.storage.k8s.io/provisioner-secret-namespace": provisionerSecretNamespace,
+			},
+			wantCreateCall: true,
+		},
+		{
+			name: "error: unknown key under reserved prefix is a permanent StorageClass error, no retry",
+			scParameters: map[string]string{
+				"csi.storage.k8s.io/bogus": "x",
+			},
+			wantCreateCall:  false,
+			wantEventReason: "VRRInvalidStorageClass",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			defer ctrl.Finish()
+
+			sc := ourStorageClass()
+			sc.Parameters = tt.scParameters
+
+			mockSCLister := NewMockStorageClassLister(ctrl)
+			mockSCLister.storageClasses[vrrTestStorageClass] = sc
+
+			vrr := createTestVRR("test-vrr", "test-ns", "VolumeSnapshotContent", "test-vsc")
+			vsc := readyVSC("test-vsc", vrrTestSnapshotHandle)
+			snapshotClient := snapfake.NewSimpleClientset(vsc)
+
+			kubeClient := fakeclientset.NewSimpleClientset()
+			if tt.wantCreateCall {
+				secret := &v1.Secret{
+					ObjectMeta: metav1.ObjectMeta{Name: provisionerSecretName, Namespace: provisionerSecretNamespace},
+					Data:       map[string][]byte{"password": []byte("s3cr3t")},
+				}
+				if _, err := kubeClient.CoreV1().Secrets(secret.Namespace).Create(context.Background(), secret, metav1.CreateOptions{}); err != nil {
+					t.Fatalf("failed to seed secret: %v", err)
+				}
+			}
+
+			createVolumeCalled := false
+			var gotParameters map[string]string
+			var gotSecrets map[string]string
+			mockCSIClient := &mockControllerClient{
+				createVolumeFunc: func(_ context.Context, req *csi.CreateVolumeRequest) (*csi.CreateVolumeResponse, error) {
+					createVolumeCalled = true
+					gotParameters = req.Parameters
+					gotSecrets = req.Secrets
+					if !tt.wantCreateCall {
+						t.Error("CSI CreateVolume must not be called for a StorageClass with an unknown reserved-prefix parameter")
+					}
+					return &csi.CreateVolumeResponse{Volume: &csi.Volume{VolumeId: "new-volume-id", CapacityBytes: 1024 * 1024 * 1024}}, nil
+				},
+			}
+
+			eventRecorder := record.NewFakeRecorder(10)
+			e := newTestExecutor(mockCSIClient, mockSCLister, kubeClient, snapshotClient, eventRecorder)
+
+			if err := reconcileVRR(t, e, vrr); err != nil {
+				t.Fatalf("reconcile returned unexpected error: %v", err)
+			}
+
+			if createVolumeCalled != tt.wantCreateCall {
+				t.Fatalf("CreateVolume called = %v, want %v", createVolumeCalled, tt.wantCreateCall)
+			}
+
+			if tt.wantEventReason != "" {
+				if !waitForEvent(eventRecorder, tt.wantEventReason) {
+					t.Errorf("Expected event with reason %s", tt.wantEventReason)
+				}
+				assertNoPVC(t, kubeClient)
+				return
+			}
+
+			for reservedKey := range map[string]string{
+				"csi.storage.k8s.io/provisioner-secret-name":      "",
+				"csi.storage.k8s.io/provisioner-secret-namespace": "",
+			} {
+				if _, ok := gotParameters[reservedKey]; ok {
+					t.Errorf("reserved parameter %q leaked into CSI CreateVolume request Parameters: %v", reservedKey, gotParameters)
+				}
+			}
+			wantPlain := map[string]string{"server": "1.2.3.4", "share": "/export"}
+			for k, v := range wantPlain {
+				if gotParameters[k] != v {
+					t.Errorf("plain parameter %q = %q, want %q (got %v)", k, gotParameters[k], v, gotParameters)
+				}
+			}
+			if len(gotParameters) != len(wantPlain) {
+				t.Errorf("CreateVolume Parameters = %v, want exactly %v", gotParameters, wantPlain)
+			}
+
+			// The provisioner secret must still resolve from the raw sc.Parameters -
+			// removePrefixedParameters must not affect getSecretReference's input.
+			if gotSecrets["password"] != "s3cr3t" {
+				t.Errorf("expected provisioner secret to resolve from raw StorageClass parameters, got Secrets=%v", gotSecrets)
+			}
+		})
+	}
+}

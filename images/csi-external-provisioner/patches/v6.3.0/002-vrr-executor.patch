+			secrets: []string{secretNamespace + "/" + secretName},
+			want: &v1.CSIPersistentVolumeSource{
+				ControllerPublishSecretRef: ref(secretName, secretNamespace),
+				NodeStageSecretRef:         ref(secretName, secretNamespace),
+				NodePublishSecretRef:       ref(secretName, secretNamespace),
+				ControllerExpandSecretRef:  ref(secretName, secretNamespace),
+				NodeExpandSecretRef:        ref(secretName, secretNamespace),
+			},
+			wantAnnotations: map[string]string{
+				annModifyControllerSecretRefName:      secretName,
+				annModifyControllerSecretRefNamespace: secretNamespace,

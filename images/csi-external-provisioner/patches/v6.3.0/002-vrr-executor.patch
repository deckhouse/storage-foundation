+// TestReconcile_RecordsProvisionerDeletionSecret verifies that the PV the executor creates
+// names the provisioner secret in the deletion-secret annotations, on both source paths.
+// Empty annotations tell the upstream deleter that the volume needs no secret and it does
+// not fall back to the StorageClass, so a driver keeping delete-time settings in that
+// secret (csi-nfs: mount options, volume cleanup method) would delete without them.
+func TestReconcile_RecordsProvisionerDeletionSecret(t *testing.T) {
+	const (
+		provisionerSecretName      = "vrr-provisioner-secret"
+		provisionerSecretNamespace = "vrr-secret-ns"
+	)
+	withSecret := map[string]string{
+		"csi.storage.k8s.io/provisioner-secret-name":      provisionerSecretName,
+		"csi.storage.k8s.io/provisioner-secret-namespace": provisionerSecretNamespace,
+	}
+
+	tests := []struct {
+		name          string
+		sourceKind    string
+		scParameters  map[string]string
+		wantName      string
+		wantNamespace string
+	}{
+		{
+			name:          "success: VolumeSnapshotContent source records the StorageClass provisioner secret",
+			sourceKind:    "VolumeSnapshotContent",
+			scParameters:  withSecret,
+			wantName:      provisionerSecretName,
+			wantNamespace: provisionerSecretNamespace,
+		},
+		{
+			name:          "success: PersistentVolume source records the StorageClass provisioner secret",
+			sourceKind:    "PersistentVolume",
+			scParameters:  withSecret,
+			wantName:      provisionerSecretName,
+			wantNamespace: provisionerSecretNamespace,
+		},
+		{
+			name:         "success: StorageClass without a provisioner secret records empty annotations",
+			sourceKind:   "VolumeSnapshotContent",
+			scParameters: map[string]string{"server": "1.2.3.4"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			defer ctrl.Finish()
+
+			sc := ourStorageClass()
+			sc.Parameters = tt.scParameters
+			mockSCLister := NewMockStorageClassLister(ctrl)
+			mockSCLister.storageClasses[vrrTestStorageClass] = sc
+
+			secret := &v1.Secret{
+				ObjectMeta: metav1.ObjectMeta{Name: provisionerSecretName, Namespace: provisionerSecretNamespace},
+				Data:       map[string][]byte{"password": []byte("s3cr3t")},
+			}
+			var vrr *storagev1alpha1.VolumeRestoreRequest
+			var kubeClient *fakeclientset.Clientset
+			var snapshotClient *snapfake.Clientset
+			switch tt.sourceKind {
+			case "VolumeSnapshotContent":
+				vrr = createTestVRR("test-vrr", "test-ns", "VolumeSnapshotContent", "test-vsc")
+				kubeClient = fakeclientset.NewSimpleClientset(secret)
+				snapshotClient = snapfake.NewSimpleClientset(readyVSC("test-vsc", vrrTestSnapshotHandle))
+			case "PersistentVolume":
+				vrr = createTestVRR("test-vrr", "test-ns", "PersistentVolume", "source-pv")
+				kubeClient = fakeclientset.NewSimpleClientset(secret, csiPV("source-pv", vrrTestVolumeHandle))
+			}
+
+			mockCSIClient := &mockControllerClient{
+				createVolumeFunc: func(_ context.Context, _ *csi.CreateVolumeRequest) (*csi.CreateVolumeResponse, error) {
+					return &csi.CreateVolumeResponse{Volume: &csi.Volume{VolumeId: "new-volume-id", CapacityBytes: 1024 * 1024 * 1024}}, nil
+				},
+			}
+
+			e := newTestExecutor(mockCSIClient, mockSCLister, kubeClient, snapshotClient, nil)
+			if err := reconcileVRR(t, e, vrr); err != nil {
+				t.Fatalf("reconcile failed: %v", err)
+			}
+
+			pvName := expectedPVName(t, vrr)
+			pv, err := kubeClient.CoreV1().PersistentVolumes().Get(context.Background(), pvName, metav1.GetOptions{})
+			if err != nil {
+				t.Fatalf("expected PV %s to exist: %v", pvName, err)
+			}
+			for ann, want := range map[string]string{
+				annDeletionProvisionerSecretRefName:      tt.wantName,
+				annDeletionProvisionerSecretRefNamespace: tt.wantNamespace,
+			} {
+				got, ok := pv.Annotations[ann]
+				if !ok {
+					t.Errorf("PV annotation %q is missing; the deleter would fall back to the StorageClass instead of the recorded secret", ann)
+					continue
+				}
+				if got != want {
+					t.Errorf("PV annotation %q = %q, want %q", ann, got, want)
+				}
+			}
+		})
+	}
+}

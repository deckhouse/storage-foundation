+func TestReconcile_RechecksRequestBeforeCreateVolume(t *testing.T) {
+	tests := []struct {
+		name        string
+		stored      func(vrr *storagev1alpha1.VolumeRestoreRequest) *storagev1alpha1.VolumeRestoreRequest
+		wantRestore bool
+	}{
+		{name: "unchanged request", stored: func(vrr *storagev1alpha1.VolumeRestoreRequest) *storagev1alpha1.VolumeRestoreRequest { return vrr }, wantRestore: true},
+		{name: "request refused meanwhile", stored: func(vrr *storagev1alpha1.VolumeRestoreRequest) *storagev1alpha1.VolumeRestoreRequest {
+			vrr.Status.Conditions = []metav1.Condition{{Type: storagev1alpha1.ConditionTypeReady, Status: metav1.ConditionFalse, Reason: storagev1alpha1.ConditionReasonForeignSource}}
+			return vrr
+		}},
+		{name: "request refused meanwhile with the verification kept", stored: func(vrr *storagev1alpha1.VolumeRestoreRequest) *storagev1alpha1.VolumeRestoreRequest {
+			vrr.Status.Conditions = append(vrr.Status.Conditions, metav1.Condition{Type: storagev1alpha1.ConditionTypeReady, Status: metav1.ConditionFalse, Reason: storagev1alpha1.ConditionReasonForeignSource})
+			return vrr
+		}},
+		{name: "verification withdrawn meanwhile", stored: func(vrr *storagev1alpha1.VolumeRestoreRequest) *storagev1alpha1.VolumeRestoreRequest {
+			vrr.Status.Conditions = nil
+			return vrr
+		}},
+		{name: "request changed meanwhile", stored: func(vrr *storagev1alpha1.VolumeRestoreRequest) *storagev1alpha1.VolumeRestoreRequest {
+			vrr.Generation++
+			vrr.Status.Conditions[0].ObservedGeneration = vrr.Generation
+			return vrr
+		}},
+		{name: "request recreated meanwhile", stored: func(vrr *storagev1alpha1.VolumeRestoreRequest) *storagev1alpha1.VolumeRestoreRequest {
+			vrr.UID = "recreated"
+			return vrr
+		}},
+		{name: "request deleted meanwhile", stored: func(*storagev1alpha1.VolumeRestoreRequest) *storagev1alpha1.VolumeRestoreRequest { return nil }},
+	}
+
+	for _, kind := range []string{"VolumeSnapshotContent", "PersistentVolume"} {
+		for _, tt := range tests {
+			t.Run(kind+"/"+tt.name, func(t *testing.T) {
+				testRecheckBeforeCreateVolume(t, kind, tt.stored, tt.wantRestore)
+			})
+		}
+	}
+}
+
+func testRecheckBeforeCreateVolume(t *testing.T, kind string, storedFn func(*storagev1alpha1.VolumeRestoreRequest) *storagev1alpha1.VolumeRestoreRequest, wantRestore bool) {
+	ctrl := gomock.NewController(t)
+	mockSCLister := NewMockStorageClassLister(ctrl)
+	mockSCLister.storageClasses[vrrTestStorageClass] = ourStorageClass()
+
+	kubeClient := fakeclientset.NewSimpleClientset()
+	snapshotClient := snapfake.NewSimpleClientset()
+	if kind == "VolumeSnapshotContent" {
+		vsc := readyVSC("source", vrrTestSnapshotHandle)
+		vsc.Spec.VolumeSnapshotRef = v1.ObjectReference{Namespace: vrrTestTargetNamespace}
+		snapshotClient = snapfake.NewSimpleClientset(vsc)
+	} else {
+		pv := csiPV("source", vrrTestVolumeHandle)
+		pv.Spec.ClaimRef = &v1.ObjectReference{Namespace: vrrTestTargetNamespace, Name: "claim"}
+		kubeClient = fakeclientset.NewSimpleClientset(pv)
+	}
+
+	created := 0
+	csiClient := &mockControllerClient{
+		createVolumeFunc: func(context.Context, *csi.CreateVolumeRequest) (*csi.CreateVolumeResponse, error) {
+			created++
+			return &csi.CreateVolumeResponse{Volume: &csi.Volume{VolumeId: "new-volume-id", CapacityBytes: 1024 * 1024 * 1024}}, nil
+		},
+	}
+	e := newTestExecutor(csiClient, mockSCLister, kubeClient, snapshotClient, nil)
+
+	vrr := createTestVRR("test-vrr", vrrTestTargetNamespace, kind, "source")
+	if stored := storedFn(vrr.DeepCopy()); stored != nil {
+		storeVRR(t, e, stored)
+	}
+	if err := e.reconcile(context.Background(), vrr); err != nil {
+		t.Fatalf("reconcile failed: %v", err)
+	}
+
+	if !wantRestore {
+		if created != 0 {
+			t.Fatalf("CreateVolume was called %d times for a request that is no longer restorable", created)
+		}
+		if _, err := kubeClient.CoreV1().PersistentVolumes().Get(context.Background(), expectedPVName(t, vrr), metav1.GetOptions{}); !apierrors.IsNotFound(err) {
+			t.Fatalf("expected no restored PV, got err=%v", err)
+		}
+		assertNoPVC(t, kubeClient)
+		return
+	}
+	if created != 1 {
+		t.Fatalf("CreateVolume was called %d times, want 1", created)
+	}
+	assertPVCBoundTo(t, kubeClient, expectedPVName(t, vrr))
+}

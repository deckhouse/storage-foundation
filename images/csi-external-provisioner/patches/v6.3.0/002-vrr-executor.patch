+// TestReconcile_FromPV_VolumeCapacityPrecedence mirrors
+// TestReconcile_FromVSC_VolumeCapacityPrecedence for the clone-from-PV path: the
+// requested pvcTemplate size wins over a smaller source PV capacity, but the restored
+// volume never goes below what the source PV holds.
+func TestReconcile_FromPV_VolumeCapacityPrecedence(t *testing.T) {
+	tests := []struct {
+		name             string
+		requestedStorage *resource.Quantity
+		wantCapacity     int64
+	}{
+		{
+			name:             "success: requested size wins over a smaller source PV capacity",
+			requestedStorage: quantityPtr(resource.MustParse("10Gi")),
+			wantCapacity:     10 * 1024 * 1024 * 1024,
+		},
+		{
+			name:         "success: source PV capacity is used when no size is requested",
+			wantCapacity: 3 * 1024 * 1024 * 1024,
+		},
+		{
+			name:             "success: source PV capacity wins when larger than the requested size",
+			requestedStorage: quantityPtr(resource.MustParse("500Mi")),
+			wantCapacity:     3 * 1024 * 1024 * 1024,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			defer ctrl.Finish()
+
+			mockSCLister := NewMockStorageClassLister(ctrl)
+			mockSCLister.storageClasses[vrrTestStorageClass] = ourStorageClass()
+
+			vrr := createTestVRR("test-vrr", "test-ns", "PersistentVolume", "source-pv")
+			if tt.requestedStorage != nil {
+				vrr.Spec.PvcTemplate.Resources.Requests = storagev1alpha1.ResourceList{
+					storagev1alpha1.ResourceStorage: *tt.requestedStorage,
+				}
+			}
+			sourcePV := csiPV("source-pv", vrrTestVolumeHandle)
+			// 3Gi rather than the 1Gi csiPV defaults to: an implementation that ignored the
+			// source capacity and fell through to defaultVolumeCapacityBytes would otherwise
+			// still satisfy the expectations below.
+			sourcePV.Spec.Capacity = v1.ResourceList{v1.ResourceStorage: resource.MustParse("3Gi")}
+
+			kubeClient := fakeclientset.NewSimpleClientset(sourcePV)
+
+			var gotRequiredBytes int64
+			mockCSIClient := &mockControllerClient{
+				createVolumeFunc: func(_ context.Context, req *csi.CreateVolumeRequest) (*csi.CreateVolumeResponse, error) {
+					gotRequiredBytes = req.CapacityRange.GetRequiredBytes()
+					// Mimic csi-driver-nfs: CapacityBytes 0 means "use the requested size".
+					return &csi.CreateVolumeResponse{Volume: &csi.Volume{VolumeId: "new-volume-id", CapacityBytes: 0}}, nil
+				},
+			}
+
+			e := newTestExecutor(mockCSIClient, mockSCLister, kubeClient, nil, nil)
+			if err := reconcileVRR(t, e, vrr); err != nil {
+				t.Fatalf("reconcile failed: %v", err)
+			}
+
+			if gotRequiredBytes != tt.wantCapacity {
+				t.Errorf("CSI CreateVolumeRequest.CapacityRange.RequiredBytes = %d, want %d", gotRequiredBytes, tt.wantCapacity)
+			}
+
+			pvName := expectedPVName(t, vrr)
+			pv, err := kubeClient.CoreV1().PersistentVolumes().Get(context.Background(), pvName, metav1.GetOptions{})
+			if err != nil {
+				t.Fatalf("expected PV %s to exist: %v", pvName, err)
+			}
+			if got := pv.Spec.Capacity[v1.ResourceStorage]; got.Value() != tt.wantCapacity {
+				t.Errorf("PV Capacity = %s (%d bytes), want %d bytes", got.String(), got.Value(), tt.wantCapacity)
+			}
+
+			pvc, err := kubeClient.CoreV1().PersistentVolumeClaims(vrrTestTargetNamespace).Get(context.Background(), vrrTestTargetPVCName, metav1.GetOptions{})
+			if err != nil {
+				t.Fatalf("expected target PVC to exist: %v", err)
+			}
+			if got := pvc.Spec.Resources.Requests[v1.ResourceStorage]; got.Value() != tt.wantCapacity {
+				t.Errorf("PVC Resources.Requests[storage] = %s (%d bytes), want %d bytes", got.String(), got.Value(), tt.wantCapacity)
+			}
+		})
+	}
+}

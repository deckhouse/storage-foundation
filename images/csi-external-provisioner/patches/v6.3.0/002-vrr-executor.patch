+func storeVRR(t *testing.T, e *VRRExecutor, vrr *storagev1alpha1.VolumeRestoreRequest) {
+	t.Helper()
+	content, err := runtime.DefaultUnstructuredConverter.ToUnstructured(vrr)
+	if err != nil {
+		t.Fatalf("failed to convert VRR: %v", err)
+	}
+	u := &unstructured.Unstructured{Object: content}
+	u.SetAPIVersion(vrrResource.GroupVersion().String())
+	u.SetKind("VolumeRestoreRequest")
+	client := e.vrrClient.Resource(vrrResource).Namespace(vrr.Namespace)
+	_, err = client.Create(context.Background(), u, metav1.CreateOptions{})
+	if apierrors.IsAlreadyExists(err) {
+		_, err = client.Update(context.Background(), u, metav1.UpdateOptions{})
+	}
+	if err != nil {
+		t.Fatalf("failed to store VRR: %v", err)
+	}
+}
+
+func reconcileVRR(t *testing.T, e *VRRExecutor, vrr *storagev1alpha1.VolumeRestoreRequest) error {
+	t.Helper()
+	storeVRR(t, e, vrr)
+	return e.reconcile(context.Background(), vrr)
+}

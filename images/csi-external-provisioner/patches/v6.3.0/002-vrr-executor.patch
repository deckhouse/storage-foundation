+func TestReconcile_SourceNamespace(t *testing.T) {
+	const foreignNamespace = "other-ns"
+
+	verified := func(status metav1.ConditionStatus, generation int64) []metav1.Condition {
+		return []metav1.Condition{{
+			Type:               storagev1alpha1.ConditionTypeSourceVerified,
+			Status:             status,
+			Reason:             storagev1alpha1.ConditionReasonModuleNamespace,
+			ObservedGeneration: generation,
+		}}
+	}
+	vscIn := func(namespace string) *crdv1.VolumeSnapshotContent {
+		vsc := readyVSC("source", vrrTestSnapshotHandle)
+		vsc.Spec.VolumeSnapshotRef = v1.ObjectReference{Namespace: namespace}
+		return vsc
+	}
+	pvIn := func(namespace string) *v1.PersistentVolume {
+		pv := csiPV("source", vrrTestVolumeHandle)
+		pv.Spec.ClaimRef = nil
+		if namespace != "" {
+			pv.Spec.ClaimRef = &v1.ObjectReference{Namespace: namespace, Name: "claim"}
+		}
+		return pv
+	}
+
+	tests := []struct {
+		name        string
+		vsc         *crdv1.VolumeSnapshotContent
+		pv          *v1.PersistentVolume
+		conditions  []metav1.Condition
+		wantRestore bool
+	}{
+		{name: "snapshot of the request namespace not verified yet", vsc: vscIn(vrrTestTargetNamespace)},
+		{name: "snapshot of the request namespace verified by the controller", vsc: vscIn(vrrTestTargetNamespace), conditions: verified(metav1.ConditionTrue, 2), wantRestore: true},
+		{name: "snapshot of the request namespace verified for an older generation", vsc: vscIn(vrrTestTargetNamespace), conditions: verified(metav1.ConditionTrue, 1)},
+		{name: "snapshot of another namespace", vsc: vscIn(foreignNamespace)},
+		{name: "unbound snapshot", vsc: vscIn("")},
+		{name: "snapshot of another namespace verified by the controller", vsc: vscIn(foreignNamespace), conditions: verified(metav1.ConditionTrue, 2), wantRestore: true},
+		{name: "unbound snapshot verified by the controller", vsc: vscIn(""), conditions: verified(metav1.ConditionTrue, 2), wantRestore: true},
+		{name: "unbound snapshot verified for an older generation", vsc: vscIn(""), conditions: verified(metav1.ConditionTrue, 1)},
+		{name: "unbound snapshot not verified", vsc: vscIn(""), conditions: verified(metav1.ConditionFalse, 2)},
+		{name: "volume of the request namespace not verified yet", pv: pvIn(vrrTestTargetNamespace)},
+		{name: "volume of the request namespace verified by the controller", pv: pvIn(vrrTestTargetNamespace), conditions: verified(metav1.ConditionTrue, 2), wantRestore: true},
+		{name: "volume of another namespace", pv: pvIn(foreignNamespace)},
+		{name: "detached volume", pv: pvIn("")},
+		{name: "volume of another namespace verified by the controller", pv: pvIn(foreignNamespace), conditions: verified(metav1.ConditionTrue, 2), wantRestore: true},
+		{name: "detached volume verified for an older generation", pv: pvIn(""), conditions: verified(metav1.ConditionTrue, 1)},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			mockSCLister := NewMockStorageClassLister(ctrl)
+			mockSCLister.storageClasses[vrrTestStorageClass] = ourStorageClass()
+
+			kind := "VolumeSnapshotContent"
+			kubeClient := fakeclientset.NewSimpleClientset()
+			snapshotClient := snapfake.NewSimpleClientset()
+			if tt.vsc != nil {
+				snapshotClient = snapfake.NewSimpleClientset(tt.vsc)
+			} else {
+				kind = "PersistentVolume"
+				kubeClient = fakeclientset.NewSimpleClientset(tt.pv)
+			}
+
+			vrr := createTestVRR("test-vrr", vrrTestTargetNamespace, kind, "source")

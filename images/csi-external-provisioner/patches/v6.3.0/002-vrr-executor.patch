+				"nodeStageSecretRef":         {got.NodeStageSecretRef, tt.want.NodeStageSecretRef},
+				"nodePublishSecretRef":       {got.NodePublishSecretRef, tt.want.NodePublishSecretRef},
+				"controllerExpandSecretRef":  {got.ControllerExpandSecretRef, tt.want.ControllerExpandSecretRef},
+				"nodeExpandSecretRef":        {got.NodeExpandSecretRef, tt.want.NodeExpandSecretRef},
+			} {
+				if !reflect.DeepEqual(pair[0], pair[1]) {
+					t.Errorf("PV spec.csi.%s = %v, want %v", field, pair[0], pair[1])

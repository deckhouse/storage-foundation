+// snapshotFinalizersPatch is a JSON merge patch that sets metadata.finalizers
+// of a VolumeSnapshot and nothing else. metadata.resourceVersion makes the
+// write conditional: the API server rejects it with a Conflict when the
+// object changed since it was read, so a concurrent finalizer writer is never
+// silently overwritten by the replaced list.
+type snapshotFinalizersPatch struct {
+	Metadata snapshotFinalizersPatchMeta `json:"metadata"`
+}
+
+type snapshotFinalizersPatchMeta struct {
+	Finalizers      []string `json:"finalizers"`
+	ResourceVersion string   `json:"resourceVersion,omitempty"`
+}
+
+// patchSnapshotFinalizers sets the finalizers of snapshot to finalizers with a
+// JSON merge patch of metadata.finalizers only.
+//
+// A full Update is not used on purpose: the typed VolumeSnapshot does not know
+// the fields a VolumeSnapshot CRD may add to spec (such as spec.mode), so an
+// Update of the decoded object drops them, the API server defaults them back
+// and CRD transition rules (e.g. an immutable spec.mode) reject the write.
+func patchSnapshotFinalizers(ctx context.Context, client snapclientset.Interface, snapshot *snapapi.VolumeSnapshot, finalizers []string) error {
+	if finalizers == nil {
+		finalizers = []string{}
+	}
+	data, err := json.Marshal(snapshotFinalizersPatch{
+		Metadata: snapshotFinalizersPatchMeta{
+			Finalizers:      finalizers,
+			ResourceVersion: snapshot.ResourceVersion,
+		},
+	})
+	if err != nil {
+		return err
+	}
+	_, err = client.SnapshotV1().VolumeSnapshots(snapshot.Namespace).Patch(ctx, snapshot.Name, types.MergePatchType, data, metav1.PatchOptions{})
+	return err
+}
+
 func markAsMigrated(parent context.Context, hasMigrated bool) context.Context {
 	return context.WithValue(parent, connection.AdditionalInfoKey, connection.AdditionalInfo{Migrated: strconv.FormatBool(hasMigrated)})
 }

diff --git a/pkg/controller/snapshot_finalizer_patch_test.go b/pkg/controller/snapshot_finalizer_patch_test.go
new file mode 100644
index 00000000..8b825367
--- /dev/null
+++ b/pkg/controller/snapshot_finalizer_patch_test.go
@@ -0,0 +1,211 @@
+package controller
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"slices"
+	"testing"
+
+	v1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+	"k8s.io/apimachinery/pkg/types"
+	k8stesting "k8s.io/client-go/testing"
+
+	crdv1 "github.com/kubernetes-csi/external-snapshotter/client/v8/apis/volumesnapshot/v1"
+	snapshotfake "github.com/kubernetes-csi/external-snapshotter/client/v8/clientset/versioned/fake"
+)
+
+// snapshotFinalizersFromPatch checks that action is a JSON merge patch of a
+// VolumeSnapshot which carries metadata.finalizers and metadata.resourceVersion
+// and nothing else, and returns the finalizers it sets.
+func snapshotFinalizersFromPatch(action k8stesting.Action) ([]string, error) {
+	patchAction, ok := action.(k8stesting.PatchAction)
+	if !ok {
+		return nil, fmt.Errorf("expected PatchAction, got %T", action)
+	}
+	if patchAction.GetPatchType() != types.MergePatchType {
+		return nil, fmt.Errorf("expected patch type %q, got %q", types.MergePatchType, patchAction.GetPatchType())
+	}
+	var body map[string]map[string]json.RawMessage
+	if err := json.Unmarshal(patchAction.GetPatch(), &body); err != nil {
+		return nil, fmt.Errorf("patch %s is not metadata-only: %v", patchAction.GetPatch(), err)
+	}
+	if len(body) != 1 || body["metadata"] == nil {
+		return nil, fmt.Errorf("patch %s touches more than metadata", patchAction.GetPatch())
+	}
+	for key := range body["metadata"] {
+		if key != "finalizers" && key != "resourceVersion" {
+			return nil, fmt.Errorf("patch %s touches metadata.%s", patchAction.GetPatch(), key)
+		}
+	}
+	if _, ok := body["metadata"]["resourceVersion"]; !ok {
+		return nil, fmt.Errorf("patch %s carries no metadata.resourceVersion", patchAction.GetPatch())
+	}
+	var finalizers []string
+	if err := json.Unmarshal(body["metadata"]["finalizers"], &finalizers); err != nil || finalizers == nil {
+		return nil, fmt.Errorf("patch %s carries no metadata.finalizers list", patchAction.GetPatch())
+	}
+	return finalizers, nil
+}
+
+// snapshotWriteActions returns the create/update/patch actions on
+// volumesnapshots recorded by client.
+func snapshotWriteActions(client *snapshotfake.Clientset) []k8stesting.Action {
+	var writes []k8stesting.Action
+	for _, action := range client.Actions() {
+		if action.GetResource().Resource != "volumesnapshots" {
+			continue
+		}
+		switch action.GetVerb() {
+		case "create", "update", "patch":
+			writes = append(writes, action)
+		}
+	}
+	return writes
+}
+
+// expectSingleFinalizerPatch fails t unless client recorded exactly one write
+// on volumesnapshots, a finalizers-only merge patch that sets want.
+func expectSingleFinalizerPatch(t *testing.T, client *snapshotfake.Clientset, want []string) {
+	t.Helper()
+	writes := snapshotWriteActions(client)
+	if len(writes) != 1 {
+		t.Fatalf("expected exactly one write on volumesnapshots, got %d: %v", len(writes), writes)
+	}
+	if verb := writes[0].GetVerb(); verb != "patch" {
+		t.Fatalf("expected a patch of volumesnapshots, got %q", verb)
+	}
+	got, err := snapshotFinalizersFromPatch(writes[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("expected finalizers %v in the patch, got %v", want, got)
+	}
+}
+
+func newFinalizerTestSnapshot(finalizers ...string) *crdv1.VolumeSnapshot {
+	return &crdv1.VolumeSnapshot{
+		ObjectMeta: metav1.ObjectMeta{
+			Name:            "snap",
+			Namespace:       "default",
+			ResourceVersion: "7",
+			Finalizers:      finalizers,
+		},
+	}
+}
+
+func TestPatchSnapshotFinalizersBody(t *testing.T) {
+	testcases := map[string]struct {
+		finalizers []string
+		want       string
+	}{
+		"set": {
+			finalizers: []string{"other", snapshotSourceProtectionFinalizer},
+			want:       `{"metadata":{"finalizers":["other","` + snapshotSourceProtectionFinalizer + `"],"resourceVersion":"7"}}`,
+		},
+		"clear keeps an empty list": {
+			finalizers: nil,
+			want:       `{"metadata":{"finalizers":[],"resourceVersion":"7"}}`,
+		},
+	}
+	for name, tc := range testcases {
+		t.Run(name, func(t *testing.T) {
+			snapshot := newFinalizerTestSnapshot(snapshotSourceProtectionFinalizer)
+			client := snapshotfake.NewSimpleClientset(snapshot)
+			if err := patchSnapshotFinalizers(context.Background(), client, snapshot, tc.finalizers); err != nil {
+				t.Fatalf("patchSnapshotFinalizers: %v", err)
+			}
+			writes := snapshotWriteActions(client)
+			if len(writes) != 1 {
+				t.Fatalf("expected one write, got %v", writes)
+			}
+			if got := string(writes[0].(k8stesting.PatchAction).GetPatch()); got != tc.want {
+				t.Errorf("expected patch %s, got %s", tc.want, got)
+			}
+		})
+	}
+}
+
+func TestSetSnapshotFinalizerPatchesFinalizersOnly(t *testing.T) {
+	snapshot := newFinalizerTestSnapshot("other")
+	client := snapshotfake.NewSimpleClientset(snapshot)
+	p := &csiProvisioner{snapshotClient: client}
+
+	ref := &v1.ObjectReference{Namespace: snapshot.Namespace, Name: snapshot.Name}
+	if err := p.setSnapshotFinalizer(context.Background(), ref); err != nil {
+		t.Fatalf("setSnapshotFinalizer: %v", err)
+	}
+	expectSingleFinalizerPatch(t, client, []string{"other", snapshotSourceProtectionFinalizer})
+
+	got, err := client.SnapshotV1().VolumeSnapshots(snapshot.Namespace).Get(context.Background(), snapshot.Name, metav1.GetOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !slices.Equal(got.Finalizers, []string{"other", snapshotSourceProtectionFinalizer}) {
+		t.Errorf("unexpected finalizers after patch: %v", got.Finalizers)
+	}
+}
+
+func TestSetSnapshotFinalizerAlreadyPresent(t *testing.T) {
+	snapshot := newFinalizerTestSnapshot(snapshotSourceProtectionFinalizer)
+	client := snapshotfake.NewSimpleClientset(snapshot)
+	p := &csiProvisioner{snapshotClient: client}
+
+	ref := &v1.ObjectReference{Namespace: snapshot.Namespace, Name: snapshot.Name}
+	if err := p.setSnapshotFinalizer(context.Background(), ref); err != nil {
+		t.Fatalf("setSnapshotFinalizer: %v", err)
+	}
+	if writes := snapshotWriteActions(client); len(writes) != 0 {
+		t.Errorf("expected no write when the finalizer is present, got %v", writes)
+	}
+}
+
+func TestRemoveSnapshotFinalizerPatchesFinalizersOnly(t *testing.T) {
+	snapshot := newFinalizerTestSnapshot("other", snapshotSourceProtectionFinalizer)
+	client := snapshotfake.NewSimpleClientset(snapshot)
+	p := &csiProvisioner{snapshotClient: client}
+
+	if err := p.removeSnapshotFinalizer(context.Background(), snapshot.Namespace, snapshot.Name); err != nil {
+		t.Fatalf("removeSnapshotFinalizer: %v", err)
+	}
+	expectSingleFinalizerPatch(t, client, []string{"other"})
+}
+
+func TestSnapshotFinalizerPatchForbiddenIsIgnored(t *testing.T) {
+	forbidden := func(action k8stesting.Action) (bool, runtime.Object, error) {
+		return true, nil, apierrors.NewForbidden(schema.GroupResource{Group: "snapshot.storage.k8s.io", Resource: "volumesnapshots"}, "snap", fmt.Errorf("no patch"))
+	}
+
+	snapshot := newFinalizerTestSnapshot()
+	client := snapshotfake.NewSimpleClientset(snapshot)
+	client.PrependReactor("patch", "volumesnapshots", forbidden)
+	p := &csiProvisioner{snapshotClient: client}
+	ref := &v1.ObjectReference{Namespace: snapshot.Namespace, Name: snapshot.Name}
+	if err := p.setSnapshotFinalizer(context.Background(), ref); err != nil {
+		t.Errorf("setSnapshotFinalizer: expected Forbidden to be ignored, got %v", err)
+	}
+
+	snapshot = newFinalizerTestSnapshot(snapshotSourceProtectionFinalizer)
+	client = snapshotfake.NewSimpleClientset(snapshot)
+	client.PrependReactor("patch", "volumesnapshots", forbidden)
+	p = &csiProvisioner{snapshotClient: client}
+	if err := p.removeSnapshotFinalizer(context.Background(), snapshot.Namespace, snapshot.Name); err != nil {
+		t.Errorf("removeSnapshotFinalizer: expected Forbidden to be ignored, got %v", err)
+	}
+}
+
+func TestSweepOrphanedFinalizersPatchesFinalizersOnly(t *testing.T) {
+	snapshot := newFinalizerTestSnapshot("other", snapshotSourceProtectionFinalizer)
+	client := snapshotfake.NewSimpleClientset(snapshot)
+	ctrl := fakeSnapshotFinalizerController(client, newFakeClaimLister(), snapshot)
+
+	ctrl.sweepOrphanedFinalizers(context.Background())
+
+	expectSingleFinalizerPatch(t, client, []string{"other"})
+}

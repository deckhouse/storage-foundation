
{{- define "mount points for golang builds" }}
- from: tmp_dir
  to: /go/pkg
- from: tmp_dir
  to: /root/go/pkg
- from: tmp_dir
  to: /root/.cache/go-build
{{- end }}

{{- /* Credentials for the private fox Go modules.

       Two fox projects under github.com/deckhouse are private, and the
       builds that include this define reach one of them: state-snapshotter
       ({api,pkg/snapshotsdk}, needed by controller) and sds-common-lib (needed by
       go-hooks, data-exporter and webhooks). The public module proxy cannot serve
       either, so the fetch goes straight to GitLab over git and needs a token.
       Without one the ?go-get=1 discovery yields nothing and the Go tool falls back
       to probing path prefixes -- it ends up asking for the GROUP repository
       (github.com/deckhouse.git) and fails with a confusing
       "could not read Username".

       The token is FOX_GO_TOKEN, scoped to the group that holds both projects, with
       the pipeline's CI_JOB_TOKEN as the fallback. That order is not
       interchangeable: a job token is accepted for git operations, but the
       ?go-get=1 endpoint answers 404 for a private project, and Go reads an
       explicit 404 as "no such module" instead of probing the repository with git.
       So the fallback can only carry the git fetch, never the discovery that comes
       first -- with nothing but a job token the build still fails as above, even
       with this project on the other one's job-token allowlist.

       netrc covers the discovery request, url.insteadOf covers the git fetch, and
       GOPRIVATE keeps proxy.golang.org and sum.golang.org out of the path for the
       prefix (go.sum still pins the modules). The netrc login stays
       gitlab-ci-token: that name is what a job token requires, while a group token
       is resolved by the token value and does not care about the login, so one line
       serves both.

       An empty token is not an error here: builds that do not include this define
       reach nothing private -- they see the local modules through a filesystem
       replace -- and keep working, and a build that does reach a private module
       fails with the message above. */}}
{{- define "secret for private go modules" }}
- id: GO_PRIVATE_TOKEN
  value: {{ .GO_PRIVATE_TOKEN }}
{{- end }}

{{- define "auth for private go modules" -}}
- |
  # A proxy-less module fetch is a git fetch, and the builder images do not agree on
  # whether git is present or which package manager installs it: builder/golang has
  # neither pm nor apk in some base-images releases, builder/golang-alpine has apk,
  # the alt-based ones have pm. Install only when git is actually missing.
  if ! command -v git >/dev/null 2>&1; then
    if command -v pm >/dev/null 2>&1; then
      pm install git
    elif command -v apk >/dev/null 2>&1; then
      apk add --no-cache git
    elif command -v apt-get >/dev/null 2>&1; then
      apt-get update -qq && apt-get install -y --no-install-recommends git
    else
      echo "git is missing and no known package manager is available in this image"
      exit 1
    fi
  fi
- |
  GO_PRIVATE_TOKEN="$(cat /run/secrets/GO_PRIVATE_TOKEN)"
  export GOPRIVATE=github.com
  if [ -n "${GO_PRIVATE_TOKEN}" ]; then
    # The tightened umask is confined to a subshell. werf runs every line of a
    # stage in one shell, so a umask left set here reaches the `go build` that
    # follows and yields a 0700 binary -- unreadable to the non-root user the
    # module's containers run as, which fails at exec time, not at build time.
    ( umask 077; printf 'machine github.com login gitlab-ci-token password %s\n' "${GO_PRIVATE_TOKEN}" > "${HOME}/.netrc" )
    git config --global url."https://gitlab-ci-token:${GO_PRIVATE_TOKEN}@github.com/".insteadOf "https://github.com/"
  else
    echo "GO_PRIVATE_TOKEN is empty: modules under ${GOPRIVATE} cannot be fetched"
  fi
{{- end -}}

{{- define "svace toolchain for golang builds" -}}
{{- if ne .SVACE_ENABLED "false" }}
# The base-images catalogue carries no golang+svace builder. builder/alpine-svace is plain
# Alpine plus the analyser: its only go binary sits in /opt/svace/compilers and is not on
# PATH, so a Go build started from that image fails with "go: command not found". Keep the
# regular Go builder and add the Svace toolchain to it instead.
# ssh-static and rsync are needed by "image-build.build" to ship .svace-dir to the analyser.
- pm install svace rsync ssh-static
{{- end }}
{{- end -}}

